// Application icon and dialog resources.
 

#define IDI_APPLICATION_ICON 32512
#define IDD_CONSOLE_WINDOW 104
#define IDC_CONSOLE_COMMAND 1001
#define IDC_CONSOLE_MESSAGES 1003

// RT_ICON1/2 and RT_GROUP_ICON32512 are English (United States),0409h.
LANGUAGE 9, 1
IDI_APPLICATION_ICON ICON "application.ico"

// RT_DIALOG104 uses LANG_NEUTRAL/SUBLANG_DEFAULT,0400h.
LANGUAGE 0, 1
IDD_CONSOLE_WINDOW DIALOG 0, 0, 362, 243
STYLE 2160724160u
EXSTYLE 0
CAPTION "Need For Speed Hot Pursuit 2"
FONT 8, "System"
BEGIN
    CONTROL "", IDC_CONSOLE_COMMAND, "Edit", 1350631424, 7, 221, 348, 15
    CONTROL "", IDC_CONSOLE_MESSAGES, "ListBox", 1352745217, 7, 7, 348, 212
END

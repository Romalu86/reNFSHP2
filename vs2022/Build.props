<?xml version='1.0' encoding='utf-8'?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <NfsRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\'))</NfsRoot>
    <WindowsTargetPlatformVersion>10.0.26100.0</WindowsTargetPlatformVersion>
    <VCToolsVersion>14.35.32215</VCToolsVersion>
    <PreferredToolArchitecture>x64</PreferredToolArchitecture>
    <NfsObjectRoot>$(NfsRoot)obj\$(Platform)\$(Configuration)\</NfsObjectRoot>
    <UseMultiToolTask>true</UseMultiToolTask>
    <EnforceProcessCountAcrossBuilds>true</EnforceProcessCountAcrossBuilds>
    <BuildInParallel>true</BuildInParallel>
    <NfsBuildJobs Condition="'$(NfsBuildJobs)'==''">0</NfsBuildJobs>
    <NfsCompilerPhase Condition="'$(NfsCompilerPhase)'==''">MSVC</NfsCompilerPhase>
    <NfsMsvcObjectDirectory>$(NfsObjectRoot)msvc\</NfsMsvcObjectDirectory>
    <NfsClangObjectDirectory>$(NfsObjectRoot)clang\</NfsClangObjectDirectory>
  </PropertyGroup>
</Project>
